# Copy to .env and fill in. Never commit .env.

# From @BotFather
TELEGRAM_BOT_TOKEN=
# From https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Leave blank at first: start the bot, message it, and it will reply with this number.
OWNER_CHAT_ID=
# Optional: numeric id of the channel Meera drops notes into (starts with -100).
# Add the bot to that channel as an admin so it can read new posts.
SOURCE_CHANNEL_ID=

# Pacing (about three drafts a week). Set DELIVERY_DAYS= (empty) for on-demand only.
DELIVERY_DAYS=mon,wed,fri
DELIVERY_TIME=08:30
TIMEZONE=Asia/Kolkata

# Triage strictness: notes scoring below this never get drafted automatically.
MIN_SCORE=6

# Models (override if you want to use newer ones)
GEMINI_TRIAGE_MODEL=gemini-3.6-flash
GEMINI_RESEARCH_MODEL=gemini-3.6-flash
GEMINI_DRAFT_MODEL=gemini-3.1-pro-preview
